<Window x:Class="AugmentScale.ScaleSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Augment Scale - Scale Simulator"
        Width="1060" Height="760" MinWidth="940" MinHeight="660"
        Background="#0B1220" Foreground="#E2E8F0"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111C2E" />
        <SolidColorBrush x:Key="PanelAlt" Color="#0E1728" />
        <SolidColorBrush x:Key="Line" Color="#22304A" />
        <SolidColorBrush x:Key="Muted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#2DD4BF" />
        <SolidColorBrush x:Key="Amber" Color="#F59E0B" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2B3B55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2B3B55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2B3B55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="#E2E8F0" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2B3B55" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#3A2A05" BorderBrush="#7C5A0B"
                BorderThickness="0,0,0,1" Padding="14,9">
            <TextBlock Text="SIMULATOR - synthetic weights only. Never use these readings for legal-for-trade certificates."
                       Foreground="#FDE68A" FontSize="12" FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,12,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="LIVE WEIGHT" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WeightText" Text="0"
                                           FontFamily="Consolas" FontSize="82"
                                           FontWeight="Bold" Foreground="#F8FAFC" />
                                <TextBlock Grid.Column="1" Text="kg" FontSize="22"
                                           Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Bottom" Margin="10,0,0,16" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                <Border x:Name="StateBadge" Background="#12352F" CornerRadius="4"
                                        Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock x:Name="StateText" Text="STABLE"
                                               Foreground="{StaticResource Accent}"
                                               FontSize="11" FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="ChecksumText" Text="Last checksum: -"
                                           Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>

                            <TextBlock x:Name="FrameHexText" Text=""
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="TARGET WEIGHT" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TargetBox" Text="735" FontSize="20"
                                         FontFamily="Consolas" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Apply" Click="ApplyTarget_Click"
                                        Margin="8,0,0,0" Padding="18,8" FontWeight="SemiBold" />
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Zero" Click="Zero_Click" />
                                <Button Content="12,800 kg" Tag="12800" Click="Preset_Click" />
                                <Button Content="28,450 kg" Tag="28450" Click="Preset_Click" />
                                <Button Content="11,200 kg" Tag="11200" Click="Preset_Click" />
                            </WrapPanel>

                            <WrapPanel>
                                <Button Content="-5,000" Tag="-5000" Click="Nudge_Click" />
                                <Button Content="-1,000" Tag="-1000" Click="Nudge_Click" />
                                <Button Content="+1,000" Tag="1000" Click="Nudge_Click" />
                                <Button Content="+5,000" Tag="5000" Click="Nudge_Click" />
                            </WrapPanel>

                            <ToggleButton x:Name="MotionToggle" Content="Motion (unstable reading)"
                                          Checked="MotionToggle_Changed"
                                          Unchecked="MotionToggle_Changed"
                                          HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="SCENARIO" />
                            <ComboBox x:Name="ScenarioBox" DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectionChanged="ScenarioBox_SelectionChanged" />
                            <TextBlock x:Name="ScenarioDescriptionText" Text=""
                                       Foreground="{StaticResource Muted}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="StreamButton" Content="Stop stream"
                                        Click="StreamButton_Click" Padding="16,7"
                                        FontWeight="SemiBold" />
                                <TextBlock x:Name="StreamStateText" Grid.Column="1"
                                           Text="Streaming" Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Center" Margin="10,0,0,6" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="CONNECTION" />
                            <TextBlock Text="Point the app at:  TCP:127.0.0.1:9876"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PortBox" Text="9876" FontFamily="Consolas" />
                                <Button Grid.Column="1" Content="Restart server"
                                        Click="RestartServer_Click" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="ServerStatusText" Text=""
                                       Foreground="{StaticResource Muted}" FontSize="12"
                                       Margin="0,8,0,2" TextWrapping="Wrap" />
                            <TextBlock x:Name="ClientStatusText" Text=""
                                       Foreground="{StaticResource Amber}" FontSize="12"
                                       TextWrapping="Wrap" />
                            <Button Content="Disconnect app client"
                                    Click="DisconnectClient_Click"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="STREAM" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FpsSlider" Minimum="1" Maximum="30"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="FpsSlider_ValueChanged"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="FpsText" Grid.Column="1" Text="15 fps"
                                           FontFamily="Consolas" FontSize="13"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="FramesText" Text="0 frames sent"
                                       Foreground="{StaticResource Muted}" FontSize="12"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="Scale division d = 5 kg. Fractional weights are not simulated."
                                       Foreground="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="FRAME LOG" />
                            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                                     Height="170" FontFamily="Consolas" FontSize="11"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="{StaticResource PanelAlt}"
                                     Foreground="#93C5FD" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="14,7">
            <TextBlock Text="Simulator never touches setup.json or the ticket database. Use an isolated AUGMENTSCALE_DATA_DIR for acceptance runs."
                       Foreground="{StaticResource Muted}" FontSize="11" />
        </Border>
    </Grid>
</Window>
